Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 20
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 20
    - Class: rviz/RobotModel
      Name: UR5
      Enabled: true
      Robot Description: robot_description
      Alpha: 0.7
    - Class: rviz/Image
      Name: Camera RGB
      Enabled: true
      Image Topic: /camera/color/image_raw
      Transport Hint: raw
      Queue Size: 2
    - Class: rviz/Image
      Name: Detection Debug
      Enabled: true
      Image Topic: /vision_lab/debug_image
      Transport Hint: raw
      Queue Size: 2
    - Class: rviz/Marker
      Name: Table
      Enabled: true
      Marker Topic: /vision_lab/scene_marker
      Queue Size: 2
    - Class: rviz/MarkerArray
      Name: Estimated Cube
      Enabled: true
      Marker Topic: /vision_lab/markers
      Queue Size: 2
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 1.8
      Focal Point:
        X: 0.45
        Y: 0.30
        Z: 0.20
      Pitch: 0.75
      Yaw: 0.8
Window Geometry:
  Width: 1200
  Height: 800
