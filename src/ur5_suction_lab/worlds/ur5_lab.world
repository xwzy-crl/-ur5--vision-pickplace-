<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">

    <gravity>0 0 -9.8</gravity>

    <physics name="lab_physics" type="ode">
      <max_step_size>0.0002</max_step_size>
      <real_time_update_rate>5000</real_time_update_rate>

      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
      </ode>
    </physics>

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

  </world>
</sdf>