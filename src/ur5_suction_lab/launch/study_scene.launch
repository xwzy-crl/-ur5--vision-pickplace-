<launch>
  <arg name="gui" default="true"/>

  <param
    name="robot_description"
    command="$(find xacro)/xacro '$(find ur5_suction_lab)/urdf/ur5_suction.urdf.xacro'"
  />

  <node
    pkg="robot_state_publisher"
    type="robot_state_publisher"
    name="robot_state_publisher"
    output="screen">
    <param name="publish_frequency" value="50.0"/>
  </node>

    <include file="$(find ur_gazebo)/launch/inc/ur_control.launch.xml">
      <arg
      name="gazebo_world"
      value="$(find ur5_suction_lab)/worlds/ur5_lab.world"
    />
    <arg
      name="initial_joint_positions"
      value="-J shoulder_pan_joint 0 -J shoulder_lift_joint -1.57 -J elbow_joint 0 -J wrist_1_joint -1.57 -J wrist_2_joint 0 -J wrist_3_joint 0"
    />
    <arg
      name="controller_config_file"
      value="$(find ur_gazebo)/config/ur5_controllers.yaml"
    />

    <arg
      name="controllers"
      value="joint_state_controller eff_joint_traj_controller"
    />

    <arg
      name="stopped_controllers"
      value="joint_group_eff_controller"
    />

    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="true"/>
    <arg name="spawn_z" value="0.0"/>
    <arg name="gazebo_model_name" value="robot"/>
  </include>

  <include file="$(find ur5_vision_lab)/launch/sensors.launch"/>

</launch>